end

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "KB_ESP"
ESPFolder.Parent = game:GetService("CoreGui")

local function makeESP(obj, text, color, offsetY)
    if espRegistry[obj] then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "KB_ESP"
    billboard.Size = UDim2.new(0,140,0,40)
    billboard.StudsOffset = Vector3.new(0, offsetY or 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
    billboard.Parent = ESPFolder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.4
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.Text = text
    label.Parent = billboard

    espRegistry[obj] = billboard

    task.spawn(function()
        while espRegistry[obj] and billboard.Parent do
            task.wait(0.25)
            if Flags.ESP_EggsDistance and billboard.Adornee and billboard.Adornee.Parent then
                label.Text = string.format("%s [%d]", text, math.floor(distTo(billboard.Adornee.Position)))
            end
        end
    end)
end
local function clearESP(obj)
    if espRegistry[obj] then
        espRegistry[obj]:Destroy()
        espRegistry[obj] = nil
    end
end

