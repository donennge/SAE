local function distTo(pos)
    local char = LP.Character
    if not char then return math.huge end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return math.huge end
    return (hrp.Position - pos).Magnitude
end

local function eggStealable(m)
    if not m or not m.Parent then return false end
    if m:GetAttribute("Stolen") or m:GetAttribute("Owned") or m:GetAttribute("Locked") then return false end
    return true
end

local function getEggId(model)
    for id, cfg in pairs(EggConfig) do
        if type(cfg) == "table" then
            if cfg.Model == model.Name or cfg.ID == model.Name
                or cfg.Name == model.Name or tostring(cfg.EggId) == model.Name then
                return cfg.ID or cfg.EggId or id
            end
        end
    end
    return model.Name
end

local function closestEgg()
    local best, bestD = nil, math.huge
    for _,egg in ipairs(EggsFolder:GetChildren()) do
        if egg:IsA("Model") and eggStealable(egg) then
            local root = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
            if root then
                local d = distTo(root.Position)
                if d < bestD then best, bestD = egg, d end
            end
        end
    end
    return best
end

