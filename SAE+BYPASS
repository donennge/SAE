        Position=UDim2.new(1,-8,0,0), Size=UDim2.new(0,14,1,0)})

    local open = false
    local buttons = {}
    local function choose(v, silent)
        current.Text = v
        for opt,b in pairs(buttons) do
            tween(b, 0.15, {TextColor3 = opt == v and C.accent or C.muted})
        end
        fire(ctrl.id, v, silent)
